// ParyajNet data model.
//
// Customers have no accounts: they create a "servicio" (Order) — a sports bet
// or a lottery ticket — identified by a code and their WhatsApp number. The
// WhatsApp agent sends payment details, collects the receipt and asks winners
// for their PIX key; an admin confirms payments and finalises services.
// Money is stored as Decimal in BRL.
// Status/type columns are plain strings so the schema runs unchanged on
// SQLite (development) and PostgreSQL (production); the allowed values are
// defined as TypeScript unions in src/lib/types.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Back-office users: admins and sales agents (vendedores who sell for cash).
/// Customers never log in.
model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  name               String
  role               String    @default("ADMIN") // ADMIN | AGENT
  active             Boolean   @default(true)
  // Sessions issued before this moment are rejected (set when the password changes).
  sessionsValidAfter DateTime?
  createdAt          DateTime  @default(now())

  sales          Order[]         @relation("SoldBy")
  payouts        Order[]         @relation("PaidBy")
  passwordResets PasswordReset[]
}

/// One-time password recovery link. Only the SHA-256 of the token is stored.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdBy String? // admin who generated it; null when requested by the user
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ---------- Services (orders) ----------

model Order {
  id            String    @id @default(cuid())
  code          String    @unique // e.g. PJ7K3M9Q — the number the customer and admin use
  kind          String // SPORTS | LOTTERY
  // ONLINE: created by the customer, paid by PIX. AGENT: sold for cash by a
  // sales agent — confirmed at once and paid out in cash by an agent.
  channel       String    @default("ONLINE")
  soldById      String?
  paidById      String? // who finalised the payout
  customerName  String
  phone         String // WhatsApp number, digits with country code (5511987654321); "" for walk-in sales without one
  locale        String    @default("pt") // language the agent replies in
  amount        Decimal // what the customer pays
  potentialWin  Decimal
  // AWAITING_PAYMENT → RECEIPT_RECEIVED → CONFIRMED → WON | LOST | VOID → PAID
  // or REJECTED / EXPIRED. WON and VOID need a payout (winnings / refund).
  status        String    @default("AWAITING_PAYMENT")
  payBy         DateTime // receipt must arrive before this (kick-off / draw close)
  receiptMime   String?
  receipt       Bytes?
  receiptAt     DateTime?
  confirmedAt   DateTime?
  settledAt     DateTime?
  payout        Decimal?
  payoutKeyType String?
  payoutKey     String?
  paidAt        DateTime?
  adminNote     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  soldBy   User?             @relation("SoldBy", fields: [soldById], references: [id], onDelete: SetNull)
  paidBy   User?             @relation("PaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  bet      Bet?
  ticket   LotteryTicket?
  messages WhatsAppMessage[]

  @@index([status])
  @@index([soldById, createdAt])
  @@index([phone, createdAt])
}

/// Every WhatsApp message the agent sends or receives (audit + admin view).
model WhatsAppMessage {
  id        String   @id @default(cuid())
  phone     String
  direction String // IN | OUT
  type      String   @default("TEXT") // TEXT | IMAGE | DOCUMENT
  body      String?
  status    String // SENT | FAILED | SKIPPED (agent not configured) | RECEIVED
  error     String?
  orderId   String?
  createdAt DateTime @default(now())

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([phone, createdAt])
  @@index([createdAt])
}

// ---------- Sports ----------

model Event {
  id         String   @id @default(cuid())
  externalId String?  @unique // id in an external odds feed, if any
  sport      String // football | basketball
  league     String
  homeTeam   String
  awayTeam   String
  startsAt   DateTime
  status     String   @default("SCHEDULED") // SCHEDULED | LIVE | SETTLED | CANCELLED
  clock      String? // live match clock, e.g. "67'" or "Q3 04:12"
  homeScore  Int?
  awayScore  Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  markets Market[]

  @@index([status, startsAt])
}

model Market {
  id      String   @id @default(cuid())
  eventId String
  type    String // 1X2 | DC | ML | OU | HCP | BTTS | CS (see src/lib/sports-rules.ts)
  line    Decimal? // OU: total line; HCP: handicap applied to the home side
  key     String // type, or "type:line" — unique per event
  sort    Int      @default(0)
  status  String   @default("OPEN") // OPEN | SUSPENDED | SETTLED

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  selections Selection[]

  @@unique([eventId, key])
}

model Selection {
  id       String  @id @default(cuid())
  marketId String
  code     String // 1 | X | 2 | OVER | UNDER | YES | NO
  odds     Decimal
  result   String  @default("PENDING") // PENDING | WON | LOST | VOID

  market Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  legs   BetLeg[]

  @@unique([marketId, code])
}

model Bet {
  id           String    @id @default(cuid())
  orderId      String    @unique
  stake        Decimal
  totalOdds    Decimal
  potentialWin Decimal
  payout       Decimal?
  status       String    @default("OPEN") // OPEN | WON | LOST | VOID
  createdAt    DateTime  @default(now())
  settledAt    DateTime?

  order Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  legs  BetLeg[]

  @@index([status])
}

model BetLeg {
  id          String  @id @default(cuid())
  betId       String
  selectionId String
  odds        Decimal // odds at the moment the bet was placed
  result      String  @default("PENDING")

  bet       Bet       @relation(fields: [betId], references: [id], onDelete: Cascade)
  selection Selection @relation(fields: [selectionId], references: [id])
}

// ---------- Lottery / borlette ----------

model LotteryDraw {
  id        String    @id @default(cuid())
  name      String
  // Scheduled US state draws (null for custom draws created by an admin).
  lottery   String? // NY | FL | GA
  session   String? // MIDDAY | EVENING | NIGHT
  drawAt    DateTime?
  closesAt  DateTime
  status    String    @default("OPEN") // OPEN | SETTLED | CANCELLED
  // Official numbers for state draws: Pick 3 (3 digits) and Pick 4 (4 digits).
  pick3     String?
  pick4     String?
  // Borlette results: first prize is 3 digits (its last two digits are lot 1),
  // second and third prizes are 2 digits (lots 2 and 3). For state draws:
  // first = Pick 3, second = first half of Pick 4, third = second half.
  first     String?
  second    String?
  third     String?
  createdAt DateTime  @default(now())

  tickets LotteryTicket[]

  @@unique([lottery, session, drawAt])
  @@index([status, closesAt])
}

model LotteryTicket {
  id         String   @id @default(cuid())
  orderId    String   @unique
  drawId     String
  totalStake Decimal
  payout     Decimal?
  status     String   @default("OPEN") // OPEN | WON | LOST | VOID
  createdAt  DateTime @default(now())

  order Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  draw  LotteryDraw   @relation(fields: [drawId], references: [id])
  lines LotteryLine[]
}

model LotteryLine {
  id       String   @id @default(cuid())
  ticketId String
  type     String // BORLETTE | LOTO3 | MARIAGE
  numbers  String // "45" | "123" | "12-34"
  stake    Decimal
  payout   Decimal?
  result   String   @default("PENDING")

  ticket LotteryTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

// ---------- Advertising ----------

model Banner {
  id          String    @id @default(cuid())
  title       String // internal name / alt text
  kind        String    @default("IMAGE") // IMAGE | TEXT
  placement   String // HOME | SPORTS | LOTTERY | CASINO
  locale      String    @default("all") // all | pt | es | fr | en
  linkUrl     String?
  // IMAGE banners: wide desktop image (~4:1) and optional mobile image (~2:1).
  imageMime   String?
  image       Bytes?
  mobileMime  String?
  mobileImage Bytes?
  // TEXT banners (house ads).
  headline    String?
  body        String?
  cta         String?
  theme       String    @default("blue") // blue | yellow | red
  active      Boolean   @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  sort        Int       @default(0)
  views       Int       @default(0)
  clicks      Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([placement, active])
}

// ---------- Settings (editable in /admin/settings) ----------

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
