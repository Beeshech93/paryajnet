// ParyajNet data model.
//
// Money is stored as Decimal in the currency's major unit (e.g. 12.50 BRL).
// Status/type columns are plain strings so the schema runs unchanged on
// SQLite (development) and PostgreSQL (production); the allowed values are
// defined as TypeScript unions in src/lib/types.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  name              String
  birthDate         DateTime
  role              String    @default("USER") // USER | ADMIN
  preferredCurrency String    @default("BRL")
  selfExcludedUntil DateTime?
  kycStatus         String    @default("NONE") // NONE | PENDING | VERIFIED | REJECTED
  createdAt         DateTime  @default(now())

  wallets       Wallet[]
  payments      Payment[]
  bets          Bet[]
  tickets       LotteryTicket[]
  casinoSeeds   CasinoSeed[]
  casinoRounds  CasinoRound[]
  kycSubmissions KycSubmission[]
}

model Wallet {
  id                 String   @id @default(cuid())
  userId             String
  currency           String // BRL | MXN
  balance            Decimal  @default(0)
  dailyDepositLimit  Decimal?
  createdAt          DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  payments     Payment[]

  @@unique([userId, currency])
}

// Immutable ledger: every balance change writes one row.
model Transaction {
  id           String   @id @default(cuid())
  walletId     String
  type         String // DEPOSIT | WITHDRAWAL | BET | WIN | REFUND | ADJUSTMENT
  amount       Decimal // signed: negative for debits
  balanceAfter Decimal
  reference    String?
  createdAt    DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
}

model Payment {
  id           String   @id @default(cuid())
  userId       String
  walletId     String
  kind         String // DEPOSIT | WITHDRAWAL
  method       String // PIX | SPEI | OXXO
  provider     String   @default("mock") // payment provider that handles it (see src/lib/payment-providers)
  amount       Decimal
  status       String   @default("PENDING") // PENDING | COMPLETED | REJECTED
  providerRef  String?  @unique
  instructions String? // JSON: what the player needs to pay / where we pay out
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([status, kind])
}

// ---------- Sports ----------

model Event {
  id         String   @id @default(cuid())
  externalId String?  @unique // id in an external odds feed, if any
  sport      String // football | basketball
  league     String
  homeTeam   String
  awayTeam   String
  startsAt   DateTime
  status     String   @default("SCHEDULED") // SCHEDULED | LIVE | SETTLED | CANCELLED
  clock      String? // live match clock, e.g. "67'" or "Q3 04:12"
  homeScore  Int?
  awayScore  Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  markets Market[]

  @@index([status, startsAt])
}

model Market {
  id      String   @id @default(cuid())
  eventId String
  type    String // 1X2 | DC | ML | OU | HCP | BTTS | CS (see src/lib/sports-rules.ts)
  line    Decimal? // OU: total line; HCP: handicap applied to the home side
  key     String // type, or "type:line" — unique per event
  sort    Int      @default(0)
  status  String   @default("OPEN") // OPEN | SUSPENDED | SETTLED

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  selections Selection[]

  @@unique([eventId, key])
}

model Selection {
  id       String  @id @default(cuid())
  marketId String
  code     String // 1 | X | 2 | OVER | UNDER | YES | NO
  odds     Decimal
  result   String  @default("PENDING") // PENDING | WON | LOST | VOID

  market Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  legs   BetLeg[]

  @@unique([marketId, code])
}

model Bet {
  id           String    @id @default(cuid())
  userId       String
  walletId     String
  currency     String
  stake        Decimal
  totalOdds    Decimal
  potentialWin Decimal
  payout       Decimal?
  status       String    @default("OPEN") // OPEN | WON | LOST | VOID
  createdAt    DateTime  @default(now())
  settledAt    DateTime?

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  legs BetLeg[]

  @@index([userId, createdAt])
  @@index([status])
}

model BetLeg {
  id          String  @id @default(cuid())
  betId       String
  selectionId String
  odds        Decimal // odds at the moment the bet was placed
  result      String  @default("PENDING")

  bet       Bet       @relation(fields: [betId], references: [id], onDelete: Cascade)
  selection Selection @relation(fields: [selectionId], references: [id])
}

// ---------- Lottery / borlette ----------

model LotteryDraw {
  id        String    @id @default(cuid())
  name      String
  // Scheduled US state draws (null for custom draws created by an admin).
  lottery   String? // NY | FL | GA
  session   String? // MIDDAY | EVENING | NIGHT
  drawAt    DateTime?
  closesAt  DateTime
  status    String    @default("OPEN") // OPEN | SETTLED | CANCELLED
  // Official numbers for state draws: Pick 3 (3 digits) and Pick 4 (4 digits).
  pick3     String?
  pick4     String?
  // Borlette results: first prize is 3 digits (its last two digits are lot 1),
  // second and third prizes are 2 digits (lots 2 and 3). For state draws:
  // first = Pick 3, second = first half of Pick 4, third = second half.
  first     String?
  second    String?
  third     String?
  createdAt DateTime  @default(now())

  tickets LotteryTicket[]

  @@unique([lottery, session, drawAt])
  @@index([status, closesAt])
}

model LotteryTicket {
  id         String   @id @default(cuid())
  userId     String
  walletId   String
  drawId     String
  currency   String
  totalStake Decimal
  payout     Decimal?
  status     String   @default("OPEN") // OPEN | WON | LOST | VOID
  createdAt  DateTime @default(now())

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  draw  LotteryDraw   @relation(fields: [drawId], references: [id])
  lines LotteryLine[]

  @@index([userId, createdAt])
}

model LotteryLine {
  id       String   @id @default(cuid())
  ticketId String
  type     String // BORLETTE | LOTO3 | MARIAGE
  numbers  String // "45" | "123" | "12-34"
  stake    Decimal
  payout   Decimal?
  result   String   @default("PENDING")

  ticket LotteryTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

// ---------- Casino (provably fair) ----------

model CasinoSeed {
  id             String   @id @default(cuid())
  userId         String
  serverSeed     String // secret until the seed is rotated
  serverSeedHash String
  clientSeed     String
  nonce          Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
}

model CasinoRound {
  id             String   @id @default(cuid())
  userId         String
  walletId       String
  game           String // DICE | LIMBO
  currency       String
  stake          Decimal
  target         Decimal // dice: roll-under target; limbo: target multiplier
  outcome        Decimal // dice: roll 0-99.99; limbo: result multiplier
  multiplier     Decimal // payout multiplier if won
  payout         Decimal
  won            Boolean
  seedId         String
  nonce          Int
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ---------- KYC ----------

model KycSubmission {
  id             String    @id @default(cuid())
  userId         String
  fullName       String
  documentType   String // CPF | CURP | PASSPORT
  documentNumber String // normalised (digits / uppercase)
  status         String    @default("PENDING") // PENDING | VERIFIED | REJECTED
  reviewNote     String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  files KycFile[]

  @@index([status])
  @@index([documentType, documentNumber])
}

model KycFile {
  id           String @id @default(cuid())
  submissionId String
  kind         String // DOCUMENT_FRONT | DOCUMENT_BACK | SELFIE
  mime         String
  data         Bytes

  submission KycSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

// ---------- Advertising ----------

model Banner {
  id          String    @id @default(cuid())
  title       String // internal name / alt text
  kind        String    @default("IMAGE") // IMAGE | TEXT
  placement   String // HOME | SPORTS | LOTTERY | CASINO
  locale      String    @default("all") // all | pt | es | fr | en
  linkUrl     String?
  // IMAGE banners: wide desktop image (~4:1) and optional mobile image (~2:1).
  imageMime   String?
  image       Bytes?
  mobileMime  String?
  mobileImage Bytes?
  // TEXT banners (house ads).
  headline    String?
  body        String?
  cta         String?
  theme       String    @default("blue") // blue | yellow | red
  active      Boolean   @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  sort        Int       @default(0)
  views       Int       @default(0)
  clicks      Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([placement, active])
}
