# SQLite in development. For production switch the datasource provider in
# prisma/schema.prisma to "postgresql" and point this at your Postgres URL.
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies. Generate with: openssl rand -hex 32
AUTH_SECRET="change-me"

# Payment providers (src/lib/payment-providers/index.ts), chosen per market.
# "mock" shows a "simulate payment" button to players: development only.
PAYMENTS_PROVIDER="mock"
# PAYMENTS_PROVIDER_MX="conekta"   # SPEI + OXXO
# PAYMENTS_PROVIDER_PIX=""         # PIX provider, once integrated

# Conekta (Mexico). Webhook URL: https://<domain>/api/payments/webhook/conekta
CONEKTA_PRIVATE_KEY=""
# PEM returned by POST https://api.conekta.io/webhook_keys ("\n" escapes are fine)
CONEKTA_WEBHOOK_PUBLIC_KEY=""
# Shared secret for signed webhooks at /api/payments/webhook.
PAYMENTS_WEBHOOK_SECRET="change-me-webhook"

# Bearer token for the odds feed at /api/feed.
FEED_API_KEY="change-me-feed"

# Hold in-play bets this long before accepting them (milliseconds).
LIVE_BET_DELAY_MS="5000"

# "true" requires a verified identity (KYC) before betting or depositing.
# Withdrawals always require KYC. Brazil requires it before play.
KYC_REQUIRED_TO_PLAY="false"

# Accounts created by `npm run db:seed` (development only).
SEED_ADMIN_EMAIL="admin@paryajnet.test"
SEED_ADMIN_PASSWORD="admin-dev-123"
SEED_PLAYER_EMAIL="jogador@paryajnet.test"
SEED_PLAYER_PASSWORD="player-dev-123"
