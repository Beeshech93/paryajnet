# SQLite in development. On Vercel the app uses DATABASE_URL or the variables
# a connected Postgres store injects (e.g. <store>_DATABASE_URL).
DATABASE_URL="file:./dev.db"

# Secret used to sign admin session cookies. Generate with: openssl rand -hex 32
AUTH_SECRET="change-me"

# Public address of the site (links in WhatsApp messages).
SITE_URL="http://localhost:3000"

# ---- WhatsApp agent (Evolution API) — see evolution/README.md ----
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE="paryajnet"
# Secret in the webhook URL Evolution posts to (/api/whatsapp/webhook?token=…)
EVOLUTION_WEBHOOK_TOKEN="change-me"
# The agent's WhatsApp number (for the "open WhatsApp" button), e.g. 5511987654321
WHATSAPP_AGENT_NUMBER=""

# Services close this many minutes before kick-off / draw close, so customers can pay.
ORDER_LEAD_MINUTES="10"

# Bearer token for the odds feed (/api/feed) and lottery results (/api/lottery/results).
FEED_API_KEY="change-me"

# Lottery: minutes before each NY / FL / GA draw when betting closes.
LOTTERY_CUTOFF_MINUTES="10"
# Vercel Cron secret for /api/cron/lottery (Vercel sends it automatically).
CRON_SECRET=""

# Admin account created by `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@paryajnet.test"
SEED_ADMIN_PASSWORD="admin-dev-123"
