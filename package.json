{
  "name": "paryajnet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/set-db-provider.mjs && prisma generate && next build",
    "build:vercel": "node scripts/set-db-provider.mjs && prisma generate && prisma db push --skip-generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:push": "node scripts/set-db-provider.mjs && prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "node scripts/set-db-provider.mjs && prisma db push --force-reset && tsx prisma/seed.ts",
    "test": "tsx --test src/lib/*.test.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "next": "^15.5.26",
    "next-intl": "^4.14.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
